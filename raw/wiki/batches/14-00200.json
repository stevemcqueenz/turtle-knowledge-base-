"lastrevid": 15709, "length": 141, "new": true, "fullurl": "https://turtle-wow.fandom.com/wiki/Category:Grim_Reaches_objects", "editurl": "https://turtle-wow.fandom.com/wiki/Category:Grim_Reaches_objects?action=edit", "canonicalurl": "https://turtle-wow.fandom.com/wiki/Category:Grim_Reaches_objects"}, {"pageid": 6023, "ns": 14, "title": "Category:Grim Reaches NPCs", "revisions": [{"revid": 15713, "parentid": 0, "user": "Aeliren", "timestamp": "2025-12-09T07:15:12Z", "slots": {"main": {"contentmodel": "wikitext", "contentformat": "text/x-wiki", "content": "An NPC category for NPCs in the [[Grim Reaches]] zone.\n\n[[Category:Grim Reaches]]\n[[Category:NPCs by zone]]"}}}], "categories": [{"ns": 14, "title": "Category:Grim Reaches"}, {"ns": 14, "title": "Category:NPCs by zone"}], "contentmodel": "wikitext", "pagelanguage": "en", "pagelanguagehtmlcode": "en", "pagelanguagedir": "ltr", "touched": "2026-09-07T00:20:38Z", "lastrevid": 15713, "length": 107, "new": true, "fullurl": "https://turtle-wow.fandom.com/wiki/Category:Grim_Reaches_NPCs", "editurl": "https://turtle-wow.fandom.com/wiki/Category:Grim_Reaches_NPCs?action=edit", "canonicalurl": "https://turtle-wow.fandom.com/wiki/Category:Grim_Reaches_NPCs"}, {"pageid": 6034, "ns": 14, "title": "Category:Herbalism vendors", "revisions": [{"revid": 15729, "parentid": 0, "user": "Aeliren", "timestamp": "2025-12-09T08:13:59Z", "slots": {"main": {"contentmodel": "wikitext", "contentformat": "text/x-wiki", "content": "This category contains NPCs that sell [[herbalism]] supplies.\n\n[[Category:Herbalism|Vendors]]\n[[Category:Tradeskill vendors]]"}}}], "categories": [{"ns": 14, "title": "Category:Herbalism"}, {"ns": 14, "title": "Category:Tradeskill vendors"}], "contentmodel": "wikitext", "pagelanguage": "en", "pagelanguagehtmlcode": "en", "pagelanguagedir": "ltr", "touched": "2025-12-09T08:13:59Z", "lastrevid": 15729, "length": 125, "new": true, "fullurl": "https://turtle-wow.fandom.com/wiki/Category:Herbalism_vendors", "editurl": "https://turtle-wow.fandom.com/wiki/Category:Herbalism_vendors?action=edit", "canonicalurl": "https://turtle-wow.fandom.com/wiki/Category:Herbalism_vendors"}, {"pageid": 6067, "ns": 14, "title": "Category:Grasslands", "revisions": [{"revid": 15778, "parentid": 0, "user": "Aeliren", "timestamp": "2025-12-09T09:25:28Z", "slots": {"main": {"contentmodel": "wikitext", "contentformat": "text/x-wiki", "content": "'''Grasslands''' are too dry to support trees, so are instead covered by short or tall grasses. Found both in the tropics, the arctic, and in the temperate parts of the world, they are very varied zones. In-game, many areas are covered mainly by grasses, and as such, may be considered grasslands.\n\nThis category should list [[subzone]]s and [[zone]]s that are primarily grassy. This category is a subcategory of the [[:Category:Flats|Flats category]].\n\n[[Category:Flats]]\n[[Category:Geography]]"}}}], "categories": [{"ns": 14, "title": "Category:Flats"}, {"ns": 14, "title": "Category:Geography"}], "contentmodel": "wikitext", "pagelanguage": "en", "pagelanguagehtmlcode": "en", "pagelanguagedir": "ltr", "touched": "2025-12-09T09:25:28Z", "lastrevid": 15778, "length": 495, "new": true, "fullurl": "https://turtle-wow.fandom.com/wiki/Category:Grasslands", "editurl": "https://turtle-wow.fandom.com/wiki/Category:Grasslands?action=edit", "canonicalurl": "https://turtle-wow.fandom.com/wiki/Category:Grasslands"}, {"pageid": 6068, "ns": 14, "title": "Category:Great walls", "revisions": [{"revid": 16032, "parentid": 15780, "user": "Aeliren", "timestamp": "2025-12-09T11:34:47Z", "slots": {"main": {"contentmodel": "wikitext", "contentformat": "text/x-wiki", "content": "This category contains articles related to large walls that form borders between zones, usually with gateways through them.\n\n[[Category:Ramparts]]\n[[Category:Geography]]"}}}], "categories": [{"ns": 14, "title": "Category:Geography"}, {"ns": 14, "title": "Category:Ramparts"}], "contentmodel": "wikitext", "pagelanguage": "en", "pagelanguagehtmlcode": "en", "pagelanguagedir": "ltr", "touched": "2025-12-09T11:34:47Z", "lastrevid": 16032, "length": 169, "fullurl": "https://turtle-wow.fandom.com/wiki/Category:Great_walls", "editurl": "https://turtle-wow.fandom.com/wiki/Category:Great_walls?action=edit", "canonicalurl": "https://turtle-wow.fandom.com/wiki/Category:Great_walls"}, {"pageid": 6069, "ns": 14, "title": "Category:Hills", "revisions": [{"revid": 15781, "parentid": 0, "user": "Aeliren", "timestamp": "2025-12-09T09:27:42Z", "slots": {"main": {"contentmodel": "wikitext", "contentformat": "text/x-wiki", "content": "A '''hill''' is an elevated area that is smaller than a mountain. Some notable examples are [[Thorn Hill]] (in the [[Barrens]]) and [[Sentinel Hill]] (in [[Westfall]], which is known more for its tower).\n\n[[Category:Crags]]\n[[Category:Geography]]"}}}], "categories": [{"ns": 14, "title": "Category:Crags"}, {"ns": 14, "title": "Category:Geography"}], "contentmodel": "wikitext", "pagelanguage": "en", "pagelanguagehtmlcode": "en", "pagelanguagedir": "ltr", "touched": "2026-05-30T20:27:45Z", "lastrevid": 15781, "length": 246, "new": true, "fullurl": "https://turtle-wow.fandom.com/wiki/Category:Hills", "editurl": "https://turtle-wow.fandom.com/wiki/Category:Hills?action=edit", "canonicalurl": "https://turtle-wow.fandom.com/wiki/Category:Hills"}, {"pageid": 6087, "ns": 14, "title": "Category:Horde settlements", "revisions": [{"revid": 15813, "parentid": 0, "user": "Aeliren", "timestamp": "2025-12-09T09:45:18Z", "slots": {"main": {"contentmodel": "wikitext", "contentformat": "text/x-wiki", "content": "This category contains any [[Horde]] camp, town, village or city with either a [[flight path]] or an [[inn]] that you may want to visit on your adventures.\n\nAlso see [[:Category:Alliance settlements]] or [[:Category:Neutral settlements]].\n\n[[Category:Settlements]]\n[[Category:Horde territories]]"}}}], "categories": [{"ns": 14, "title": "Category:Horde territories"}, {"ns": 14, "title": "Category:Settlements"}], "contentmodel": "wikitext", "pagelanguage": "en", "pagelanguagehtmlcode": "en", "pagelanguagedir": "ltr", "touched": "2026-05-12T22:37:34Z", "lastrevid": 15813, "length": 295, "new": true, "fullurl": "https://turtle-wow.fandom.com/wiki/Category:Horde_settlements", "editurl": "https://turtle-wow.fandom.com/wiki/Category:Horde_settlements?action=edit", "canonicalurl": "https://turtle-wow.fandom.com/wiki/Category:Horde_settlements"}, {"pageid": 6088, "ns": 14, "title": "Category:Horde quest hubs", "revisions": [{"revid": 15814, "parentid": 0, "user": "Aeliren", "timestamp": "2025-12-09T09:46:11Z", "slots": {"main": {"contentmodel": "wikitext", "contentformat": "text/x-wiki", "content": "This category contains [[Horde]] settlements with multiple quests.\n\n[[Category:Quest hubs]]\n[[Category:Horde territories]]"}}}], "categories": [{"ns": 14, "title": "Category:Horde territories"}, {"ns": 14, "title": "Category:Quest hubs"}], "contentmodel": "wikitext", "pagelanguage": "en", "pagelanguagehtmlcode": "en", "pagelanguagedir": "ltr", "touched": "2026-05-12T22:37:34Z", "lastrevid": 15814, "length": 122, "new": true, "fullurl": "https://turtle-wow.fandom.com/wiki/Category:Horde_quest_hubs", "editurl": "https://turtle-wow.fandom.com/wiki/Category:Horde_quest_hubs?action=edit", "canonicalurl": "https://turtle-wow.fandom.com/wiki/Category:Horde_quest_hubs"}, {"pageid": 6093, "ns": 14, "title": "Category:Horde territories", "revisions": [{"revid": 15820, "parentid": 0, "user": "Aeliren", "timestamp": "2025-12-09T09:50:25Z", "slots": {"main": {"contentmodel": "wikitext", "contentformat": "text/x-wiki", "content": "This category is divided into the racial territories belonging to the [[Horde]].\n\n;See also:\n* [[:Category:Alliance territories|Alliance territories category]].\n\n[[Category:Territories]]\n[[Category:Horde| ]]"}}}], "categories": [{"ns": 14, "title": "Category:Horde"}, {"ns": 14, "title": "Category:Territories"}], "